# Copy to .env and fill in. .env is gitignored.
# Hugging Face token for gated models (Llama-2 etc.).
HF_TOKEN=
# Directory for cached Hugging Face weights.
HF_HOME=./models/hf
# Directory for compiled TensorRT engines.
ENGINE_DIR=./models/engines
# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
